{
  "name": "@codelinks/admin",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.29.1",
  "engines": {
    "node": "^24.0.0",
    "pnpm": "10.29.1"
  },
  "scripts": {
    "dev": "vite dev --host 0.0.0.0",
    "build": "svelte-kit sync && vite build",
    "preview": "vite preview --host 0.0.0.0",
    "check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
    "test": "vitest run",
    "format": "prettier --write ."
  },
  "dependencies": {
    "@codelinks/auth-client": "workspace:*",
    "@codelinks/contracts": "workspace:*",
    "@codelinks/ui": "workspace:*",
    "@lucide/svelte": "^1.14.0",
    "@sveltejs/adapter-node": "^5.5.2",
    "@sveltejs/kit": "^2.59.1",
    "@sveltejs/vite-plugin-svelte": "^7.1.2",
    "@tailwindcss/vite": "^4.3.0",
    "svelte": "^5.55.5",
    "tailwindcss": "^4.3.0",
    "typescript": "^6.0.3",
    "vite": "8.0.11"
  },
  "devDependencies": {
    "@types/node": "^25.6.2",
    "jsdom": "^29.1.1",
    "svelte-check": "^4.4.8",
    "vitest": "^4.1.6"
  }
}
