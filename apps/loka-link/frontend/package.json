{
	"name": "@codelinks/loka-link-frontend",
	"private": true,
	"version": "0.0.1",
	"type": "module",
	"scripts": {
		"paraglide": "paraglide-js compile --project ./project.inlang --outdir ./src/lib/paraglide --strategy url cookie globalVariable baseLocale --emit-ts-declarations --silent",
		"dev": "vite dev",
		"build": "pnpm paraglide && vite build",
		"preview": "vite preview",
		"prepare": "pnpm paraglide && svelte-kit sync || echo ''",
		"check": "pnpm paraglide && svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
		"check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
		"test:unit": "vitest",
		"test": "npm run test:unit -- --run"
	},
	"dependencies": {
		"@codelinks/auth-client": "workspace:*",
		"@codelinks/ui-library": "workspace:*"
	},
	"devDependencies": {
		"@inlang/paraglide-js": "^2.15.2",
		"@sveltejs/adapter-auto": "^7.0.1",
		"@sveltejs/kit": "^2.57.0",
		"@sveltejs/vite-plugin-svelte": "^7.0.0",
		"@tailwindcss/vite": "^4.2.2",
		"svelte": "^5.55.9",
		"svelte-check": "^4.4.6",
		"tailwindcss": "^4.2.2",
		"typescript": "^6.0.2",
		"vite": "^8.0.7",
		"vitest": "^4.1.3"
	}
}
