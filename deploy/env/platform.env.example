HTTP_ADDR=:8080
DATABASE_URL=postgres://codelinks_platform:platform_dev_password@postgres:5432/codelinks_platform?sslmode=disable
TOKEN_ISSUER=https://auth.codelinks.ch
COOKIE_DOMAIN=.codelinks.localhost
COOKIE_SECURE=false
ACCESS_TOKEN_TTL=10m
SESSION_TTL=720h
REFRESH_TOKEN_TTL=720h
TOKEN_SIGNING_PRIVATE_KEY_PATH=/run/secrets/platform-ed25519.pem
TOKEN_SIGNING_KID=platform-ed25519-1
AUDIENCE_PUBLIC_KEY_PATHS=infra_link=/run/secrets/infra-link-ecdh-public.pem,planer_link=/run/secrets/planer-link-ecdh-public.pem
PRODUCT_CLIENT_TOKENS=infra_link=change-me-infra-token,planer_link=change-me-planer-token
