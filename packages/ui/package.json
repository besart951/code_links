{
  "name": "@codelinks/ui",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "svelte": "./dist/index.js",
  "files": [
    "dist",
    "src/lib"
  ],
  "sideEffects": [
    "**/*.css"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "svelte": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./styles.css": "./dist/styles.css",
    "./utils": {
      "types": "./dist/utils.d.ts",
      "default": "./dist/utils.js"
    },
    "./press-effect": {
      "types": "./dist/press-effect.d.ts",
      "default": "./dist/press-effect.js"
    },
    "./*.js": {
      "types": "./dist/*.d.ts",
      "default": "./dist/*.js"
    },
    "./*": {
      "types": "./dist/*/index.d.ts",
      "svelte": "./dist/*/index.js",
      "default": "./dist/*/index.js"
    },
    "./*/*": {
      "types": "./dist/*/*.d.ts",
      "svelte": "./dist/*/*",
      "default": "./dist/*/*"
    }
  },
  "scripts": {
    "build": "svelte-package",
    "check": "svelte-check --tsconfig ./tsconfig.json",
    "test": "svelte-check --tsconfig ./tsconfig.json"
  },
  "dependencies": {
    "@internationalized/date": "^3.12.1",
    "@lucide/svelte": "^1.14.0",
    "bits-ui": "^2.18.1",
    "clsx": "^2.1.1",
    "tailwind-merge": "^3.6.0",
    "tailwind-variants": "^3.2.2",
    "tw-animate-css": "^1.4.0",
    "vaul-svelte": "1.0.0-next.7"
  },
  "devDependencies": {
    "@sveltejs/kit": "^2.59.1",
    "@sveltejs/package": "^2.5.7",
    "@sveltejs/vite-plugin-svelte": "^7.1.2",
    "svelte": "^5.55.5",
    "svelte-check": "^4.4.8",
    "tailwindcss": "^4.3.0",
    "typescript": "^6.0.3",
    "vite": "8.0.11"
  },
  "peerDependencies": {
    "svelte": "^5.0.0"
  }
}
